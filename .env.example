# Copy to .env. bin/spaced-tracker-ui and public/index.php load that file.
# A variable already set in the process environment wins, including an empty value.
# Leave SPACETRACK_IDENTITY empty for demo mode.
# Do not commit .env.

SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=
SPACETRACK_BASE_URL=https://www.space-track.org
SPACETRACK_TIMEOUT=60
SPACETRACK_VERIFY_TLS=true
SPACETRACK_RATE_PER_MINUTE=29
SPACETRACK_RATE_PER_HOUR=299
SPACETRACK_LOG_PREDICATE_VALUES=false
SPACETRACK_SESSION_TTL=7200
SPACETRACK_USER_AGENT=kschroeder-spaced-tracker/1.0
SPACETRACK_ENFORCE_ADVISORY=false
SPACETRACK_CONCURRENCY=auto

SPACED_TRACKER_DEMO=
SPACED_TRACKER_API_TOKEN=
SPACED_TRACKER_CORS_ORIGINS=
SPACED_TRACKER_HOST=127.0.0.1
SPACED_TRACKER_PORT=8088

# Live mode only. The cache directory must stay outside public/.
# SPACED_TRACKER_CACHE_DIR=
# SPACED_TRACKER_CACHE_TTL=60
